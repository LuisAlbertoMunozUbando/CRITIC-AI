# Server for existing NVIDIA Spark local inference. Adjust only after verifying your endpoint.
LLM_BASE_URL=http://127.0.0.1:8001/v1
# Explicit model identifier overrides autodiscovery; leave blank to select first announced model.
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=
LLM_TIMEOUT=180
MAX_INPUT_CHARS=16000
ENABLE_SECOND_PASS=true
PORT=8040
